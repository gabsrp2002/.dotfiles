                               popup.background.border_width=2          \
                               popup.background.corner_radius=10         \
                               popup.background.border_color=$BORDER_COLOR \
                               popup.background.color=$BASE_COLOR \
                               popup.blur_radius=20 \
                               popup.y_offset=5 \
                                                                                              \
              --add item apple.preferences popup.apple.logo                                   \
              --set apple.preferences icon=                                                  \
                               icon.color=$LAVENDER \
                               label="Preferences"                                            \
                               background.color=$TRANSPARENT \
                               label.color=$SUBTEXT_COLOR \
                               click_script="open -a 'System Preferences';sketchybar -m --set apple.logo popup.drawing=off"\
              --add item apple.activity popup.apple.logo                                      \
              --set apple.activity icon=󱎴                                                     \
                               icon.color=$YELLOW \
                               label="Activity"                                               \
                               background.color=$TRANSPARENT \
                               label.color=$SUBTEXT_COLOR \
                               click_script="kitty -e btop & sketchybar -m --set apple.logo popup.drawing=off"\
              --add item apple.lock popup.apple.logo                                          \
              --set apple.lock icon=                                                         \
                               icon.color=$RED \
                               label="Lock Screen"                                            \
                               background.color=$TRANSPARENT \
                               label.color=$SUBTEXT_COLOR \
                               click_script="pmset displaysleepnow;sketchybar -m --set apple.logo popup.drawing=off"

sketchybar --add item disk left \
           --set disk script="$PLUGIN_DIR/disk.sh" \
            update_freq=2 \
            icon="" \
            label.color=$SUBTEXT_COLOR \

sketchybar --add item front_app left \
           --set front_app script="$PLUGIN_DIR/front_app.sh" \
            icon= \
            label.color=$SUBTEXT_COLOR \
            background.color=$OVERLAY_COLOR \
           --subscribe front_app front_app_switched

sketchybar --add event rift_workspace_changed
sketchybar --add event rift_windows_changed

# Per-display workspace items. Rift keeps a separate workspace set per macOS
# Space (= per display), so each display gets its own item group:
# space.<arrangement-id>_<workspace-index>, pinned via display=<arr>.
# Clicking focuses that display first: `workspace switch` alone would act on
# whichever display is currently active (upstream limitation, see #131).
SKETCHYBAR_DISPLAYS=$(sketchybar --query displays)
for arr in $(echo "$SKETCHYBAR_DISPLAYS" | jq -r '.[]."arrangement-id"'); do
    uuid=$(echo "$SKETCHYBAR_DISPLAYS" | jq -r --argjson a "$arr" '.[] | select(."arrangement-id" == $a) | .UUID')
    WORKSPACES_JSON=$(rift-cli query workspaces --display "$uuid")
    for index in $(echo "$WORKSPACES_JSON" | jq -r '.[].index'); do
        window_count=$(echo "$WORKSPACES_JSON" | jq -r --argjson idx "$index" '.[] | select(.index == $idx) | .window_count // 0')
        icon="$index"

        icons=""
        while IFS= read -r app; do
            if [ -n "$app" ]; then
                icons+=$("$PLUGIN_DIR/icon_map_fn.sh" "$app")
                icons+="  "
            fi
        done < <(echo "$WORKSPACES_JSON" | jq -r --argjson idx "$index" '.[] | select(.index == $idx) | .windows[] | .app_name // .bundle_id // empty')

        sketchybar --add item space.${arr}_${index} left \
            --subscribe space.${arr}_${index} rift_workspace_changed rift_windows_changed display_change space_windows_change front_app_switched \
            --set space.${arr}_${index} \
            display=$arr \
            background.color=$SURFACE_COLOR \
            icon="$icon" \
            label="$icons" \
            icon.color=$SUBTEXT_COLOR \
            label.font="sketchybar-app-font:Regular:15.0" \
            label.y_offset=-1 \
            click_script="rift-cli execute display focus --uuid $uuid && rift-cli execute workspace switch $index" \
            script="$CONFIG_DIR/plugins/rift.sh $index $uuid"

        if [ -n "$icons" ]; then
            sketchybar --set space.${arr}_${index} label.drawing=on
        else
            sketchybar --set space.${arr}_${index} label.drawing=off \
                icon.padding_right=6
        fi

        if [ "$index" != "$(echo "$WORKSPACES_JSON" | jq -r '.[] | select(.is_active == true) | .index')" ] && [ "$window_count" = "0" ]; then
            sketchybar --set space.${arr}_${index} drawing=off
        fi
    done
done

# Highlight each display's active workspace.
for arr in $(echo "$SKETCHYBAR_DISPLAYS" | jq -r '.[]."arrangement-id"'); do
    uuid=$(echo "$SKETCHYBAR_DISPLAYS" | jq -r --argjson a "$arr" '.[] | select(."arrangement-id" == $a) | .UUID')
    FOCUSED_INDEX=$(rift-cli query workspaces --display "$uuid" | jq -r '.[] | select(.is_active == true) | .index')
    sketchybar --set space.${arr}_${FOCUSED_INDEX} icon.color=$BASE_COLOR label.color=$BASE_COLOR background.color=$LAVENDER
done

