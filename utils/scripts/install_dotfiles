#!/bin/zsh

set -euo pipefail

GREEN='\033[1;32m' # Light Green color
RED='\033[0;31m' # Red color
NC='\033[0m' # No Color

DOTFILES_DIR="${0:A:h:h:h}"
if [[ ! -d "$DOTFILES_DIR/.git" ]]; then
    DOTFILES_DIR="$HOME/.dotfiles"
fi
cd "$DOTFILES_DIR"

# Install homebrew
echo "\n=> Step 1: Install Homebrew"
if command -v brew >/dev/null 2>&1; then
    echo "${GREEN}Homebrew already installed!${NC}"
else
    echo "\nInstalling homebrew..."
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    echo "${GREEN}Homebrew installed!${NC}"
fi

if [[ -x /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# Install stow
echo "\n=> Step 2: Install stow"
if command -v stow >/dev/null 2>&1; then
    echo "${GREEN}stow already installed!${NC}"
else
    brew install stow
    echo "${GREEN}stow installed!${NC}"
fi

# Stow dotfiles
echo "\n=> Step 3: Stow dotfiles"
stow git kitty rift sketchybar tmux utils zsh
if [[ "$*" == *"--with-nvim"* ]]; then
    stow nvim
fi
if [[ "$*" == *"--with-latex"* ]]; then
    stow latex
fi
echo "${GREEN}Dotfiles stowed!${NC}"

# Install oh-my-zsh
echo "\n=> Step 4: Install oh-my-zsh"
if [ -d "$HOME/.oh-my-zsh" ]; then
    echo "${GREEN}oh-my-zsh already installed!${NC}"
else
    echo "\nInstalling oh-my-zsh..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/oh-my-zsh/ohmyzsh/master/tools/install.sh)" "" --unattended
    echo "${GREEN}oh-my-zsh installed!${NC}"
fi

echo "\n=> Step 5: Install oh-my-zsh plugin(s)"
if [ -d "$HOME/.oh-my-zsh/custom/plugins/zsh-syntax-highlighting" ]; then
    echo "${GREEN}zsh-syntax-highlighting already installed!${NC}"
else
    echo "\nInstalling zsh-syntax-highlighting..."
    git clone https://github.com/zsh-users/zsh-syntax-highlighting.git "${ZSH_CUSTOM:-$HOME/.oh-my-zsh/custom}/plugins/zsh-syntax-highlighting"
    echo "${GREEN}zsh-syntax-highlighting installed!${NC}"
fi

# Install homebrew packages
echo "\n=> Step 6: Install homebrew packages"
echo "\nInstalling casks..."
brew install --cask kitty # Terminal
brew install --cask raycast # Better spotlight
brew install --cask skim # For pdf preview
brew install --cask spotify # For music
brew install acsandmann/tap/rift # Tiling WM

echo "\nInstalling fonts..."
brew install --cask font-jetbrains-mono-nerd-font
brew install --cask font-sketchybar-app-font

echo "\nInstalling general packages..."
brew install blueutil
brew install btop
brew install fzf
brew install gh
brew install git-delta
brew install jq # For rift-cli / sketchybar JSON parsing
brew install felixkratz/formulae/sketchybar
brew install lazygit
brew install mpv
brew install ripgrep
brew install tmux
brew install anomalyco/tap/opencode

if [[ "$*" == *"--with-nvim"* ]]; then
    echo "\nInstalling developer tools for neovim..."
    brew install nvim
    brew install black # For python formatting
    brew install clang-format # For C/C++ formatting
    brew install stylua # For lua formatting
    brew install lua-language-server # For lua language server
    brew install prettier # For code formatting
    brew install pyright # For python LSP
    brew install taplo # For TOML formatting
    brew install texlab # For LaTeX LSP
    brew install uv
    brew install node
    npm install -g neovim
    brew install deno # For markdown preview
    echo "${GREEN}Developer tools for neovim installed!${NC}"
fi

# Give scripts permission to run
echo "\n=> Step 7: Make scripts executable"
for script in "$HOME/scripts"/*; do
    [[ -f "$script" ]] && chmod +x "$script"
done
echo "${GREEN}Scripts are now executable!${NC}"

echo "${GREEN}Installation complete!${NC}"
