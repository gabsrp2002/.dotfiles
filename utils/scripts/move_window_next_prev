#!/bin/zsh

# Move the focused window to the next/previous non-empty workspace on the
# current display and follow it, wrapping around on that display.
# (Rift's native move_window_to_workspace next/prev does not skip empty
# workspaces, so this wrapper picks the target itself. Rift's native
# next/prev are display-local in global workspace mode; this matches that.)
# Usage: move_window_next_prev next|prev

DIRECTION=${1:-next}

# One query, one jq pass: resolve the focused workspace, keep only that
# display's workspaces (global mode has one active workspace per display, so
# `is_active` is not unique), then step to the first non-empty neighbour.
WORKSPACES_JSON=$(rift-cli query workspaces)
TARGET=$(echo "$WORKSPACES_JSON" | jq -r --arg dir "$DIRECTION" '
    [.[] | select(.is_focused == true)][0] as $cur
    | if $cur == null then empty else
        ([.[] | select(.display_uuid == $cur.display_uuid)] | sort_by(.index)) as $list
        | ($list | length) as $n
        | ($list | map(.index) | index($cur.index)) as $pos
        | if $n < 2 or $pos == null then empty else
            (reduce range(1; $n) as $k ({target: null};
                if .target != null then .
                else
                    (if $dir == "next"
                     then ($pos + $k) % $n
                     else (($pos - $k) % $n + $n) % $n
                     end) as $i
                    | if $list[$i].window_count != 0
                      then .target = $list[$i].index
                      else . end
                end)
             | .target)
          end
      end')
[ -z "$TARGET" ] && exit 0

rift-cli execute workspace move-window "$TARGET" --follow >/dev/null

sketchybar --trigger rift_workspace_changed
sketchybar --trigger rift_windows_changed
