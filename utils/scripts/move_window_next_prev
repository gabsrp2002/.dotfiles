#!/bin/zsh

# Move the focused window to the next/previous non-empty workspace and follow it.
# (Rift's move_window_to_workspace always lands on empty workspaces, so this
# wraps it with skip-empty logic. Wraps around like Alt+N/P.)
# Usage: move_window_next_prev next|prev

DIRECTION=${1:-next}

WORKSPACES_JSON=$(rift-cli query workspaces)
CURRENT=$(echo "$WORKSPACES_JSON" | jq -r '.[] | select(.is_active == true) | .index')
INDEXES=("${(@f)$(echo "$WORKSPACES_JSON" | jq -r 'sort_by(.index) | .[].index')}")
N=${#INDEXES[@]}
[ "$N" -eq 0 ] && exit 0

POS=0
for i in {1..$N}; do
    if [ "${INDEXES[$i]}" = "$CURRENT" ]; then
        POS=$i
        break
    fi
done
[ "$POS" -eq 0 ] && exit 0

TARGET=""
STEP=$POS
for ((k = 0; k < N; k++)); do
    if [ "$DIRECTION" = "next" ]; then
        STEP=$((STEP % N + 1))
    else
        STEP=$(((STEP - 2 + N) % N + 1))
    fi
    CAND=${INDEXES[$STEP]}
    COUNT=$(echo "$WORKSPACES_JSON" | jq -r --argjson idx "$CAND" '.[] | select(.index == $idx) | .window_count // 0')
    CNAME=$(echo "$WORKSPACES_JSON" | jq -r --argjson idx "$CAND" '.[] | select(.index == $idx) | .name // empty')
    if [ "$COUNT" != "0" ] || [ "$CNAME" = "comm" ]; then
        TARGET=$CAND
        break
    fi
done
[ -z "$TARGET" ] && exit 0

rift-cli execute workspace move-window "$TARGET" --follow >/dev/null

sketchybar --trigger rift_workspace_changed
sketchybar --trigger rift_windows_changed
