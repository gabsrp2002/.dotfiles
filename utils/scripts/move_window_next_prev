#!/bin/zsh

# Move the focused window to the next/previous non-empty workspace on the
# CURRENT display and follow it, wrapping around within that display.
# (Rift's native move_window_to_workspace next/prev cannot skip empty
# workspaces or stay display-local in global mode, so this wrapper picks the
# target itself.)
# Usage: move_window_next_prev next|prev

DIRECTION=${1:-next}

# One query, one jq pass: resolve the focused workspace, then step through the
# current display's catalog in index order to the nearest non-empty workspace,
# wrapping.
WORKSPACES_JSON=$(rift-cli query workspaces) || exit 0
TARGET=$(echo "$WORKSPACES_JSON" | jq -r --arg dir "$DIRECTION" '
    [.[] | select(.is_focused == true)][0] as $cur
    | if $cur == null then empty else
        ([.[] | select(.display_uuid == $cur.display_uuid
                       and (.window_count != 0 or .index == $cur.index))]
         | sort_by(.index)) as $list
        | ($list | length) as $n
        | ($list | map(.index) | index($cur.index)) as $pos
        | if $n < 2 or $pos == null then empty else
            (reduce range(1; $n) as $k ({target: null};
                if .target != null then .
                else
                    (if $dir == "next"
                     then ($pos + $k) % $n
                     else (($pos - $k) % $n + $n) % $n
                     end) as $i
                    | if $list[$i].window_count != 0
                      then .target = $list[$i].index
                      else . end
                end)
             | .target)
          end
      end')
[ -z "$TARGET" ] && exit 0

rift-cli execute workspace move-window "$TARGET" --follow >/dev/null
