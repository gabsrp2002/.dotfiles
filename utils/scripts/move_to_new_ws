#!/bin/zsh

# Move the focused window to the first empty workspace on the current display
# and follow it. Reuses an existing empty workspace; only creates a new one
# when the display has no other empty workspace. (Rift's `workspace create`
# auto-switches, and indexes are append-only since there is no destroy
# command.)
#
# In global workspace mode each display has its own active workspace, so
# `is_active` is not unique. Resolve the focused workspace (globally unique via
# `is_focused`) and scope the empty-workspace search to its display.
#
# One query + one jq pass keep the hot path fast; the Sketchybar rebuild only
# runs when a workspace was actually created (reuse needs no new bar item).

WORKSPACES_JSON=$(rift-cli query workspaces)
# index, display uuid, first empty index on that display ("" when none).
RESOLVED=$(echo "$WORKSPACES_JSON" | jq -r '
    [.[] | select(.is_focused == true)][0] as $cur
    | if $cur == null then empty else
        ([.[] | select(.display_uuid == $cur.display_uuid
                       and .index != $cur.index
                       and .window_count == 0)]
         | sort_by(.index)) as $empty
        | [$cur.index, $cur.display_uuid, ($empty[0].index // "")] | @tsv
      end')
[ -z "$RESOLVED" ] && exit 0
IFS=$'\t' read -r _ UUID TARGET <<< "$RESOLVED"
[ -z "$UUID" ] && exit 0

if [ -z "$TARGET" ]; then
    rift-cli execute workspace create >/dev/null
    TARGET=$(rift-cli query workspaces --display "$UUID" 2>/dev/null | jq -r 'map(.index) | max // empty')
fi

if [ -n "$TARGET" ]; then
    rift-cli execute workspace move-window "$TARGET" --follow >/dev/null
fi

# The triggers below make rift_refresh.sh sync the bar, which also creates the
# item for a newly created workspace (no explicit rebuild needed).
sketchybar --trigger rift_workspace_changed
sketchybar --trigger rift_windows_changed
