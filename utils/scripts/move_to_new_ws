#!/bin/zsh

# Create a new Rift workspace and move the focused window to it.
# (Rift's `workspace create` auto-switches to the new workspace;
# indexes are append-only since there is no destroy command.)

rift-cli execute workspace create >/dev/null

# The new workspace is the active one with the highest index.
NEW_INDEX=$(rift-cli query workspaces | jq -r 'map(.index) | max')

rift-cli execute workspace move-window "$NEW_INDEX" --follow >/dev/null

source ~/.config/sketchybar/colors.sh

WORKSPACES_JSON=$(rift-cli query workspaces)
name=$(echo "$WORKSPACES_JSON" | jq -r --argjson idx "$NEW_INDEX" '.[] | select(.index == $idx) | .name')
if [[ "$name" == "Workspace "* ]]; then
    icon="$NEW_INDEX"
else
    icon="$name"
fi

sketchybar --add item space.$NEW_INDEX left \
    --subscribe space.$NEW_INDEX rift_workspace_changed rift_windows_changed display_change space_windows_change front_app_switched \
    --set space.$NEW_INDEX \
    background.color=$SURFACE_COLOR \
    icon="$icon" \
    icon.color=$SUBTEXT_COLOR \
    label.font="sketchybar-app-font:Regular:15.0" \
    label.y_offset=-1 \
    click_script="rift-cli execute workspace switch $NEW_INDEX" \
    script="~/.config/sketchybar/plugins/rift.sh $NEW_INDEX"

sketchybar --trigger rift_workspace_changed
sketchybar --trigger rift_windows_changed
