#!/bin/zsh

# Move the focused window to the first empty workspace (other than the
# current one) and follow it. Only creates a new workspace when no empty
# one is available. (Rift's `workspace create` auto-switches, and indexes
# are append-only since there is no destroy command.)

WORKSPACES_JSON=$(rift-cli query workspaces)
CURRENT=$(echo "$WORKSPACES_JSON" | jq -r '.[] | select(.is_active == true) | .index')
TARGET=$(echo "$WORKSPACES_JSON" | jq -r --argjson cur "$CURRENT" '[.[] | select(.index != $cur and .window_count == 0) | .index] | first // empty')

if [ -z "$TARGET" ]; then
    rift-cli execute workspace create >/dev/null
    TARGET=$(rift-cli query workspaces | jq -r 'map(.index) | max')

    # Workaround for acsandmann/rift#577: a freshly created workspace has no
    # layout object yet, so the moved window would not be added to the tiling
    # tree and would sit untiled until later events. Toggling the layout mode
    # away and back forces layout creation while the workspace is still empty.
    MODE=$(rift-cli query workspaces | jq -r --argjson t "$TARGET" '.[] | select(.index == $t) | .layout_mode // empty')
    if [ "$MODE" = "stack" ]; then ALT="traditional"; else ALT="stack"; fi
    rift-cli execute workspace set-layout "$ALT" --workspace-id "$TARGET" >/dev/null
    rift-cli execute workspace set-layout "${MODE:-traditional}" --workspace-id "$TARGET" >/dev/null
fi

rift-cli execute workspace move-window "$TARGET" --follow >/dev/null

# Rebuild workspace items (covers the new workspace; idempotent).
~/.config/sketchybar/plugins/rebuild_spaces.sh

sketchybar --trigger rift_workspace_changed
sketchybar --trigger rift_windows_changed
