#!/bin/zsh

# Print the Rift-focused window across ALL displays as:
#   display-uuid|window-idx|bundle-id|app-name
# (Active-context queries go blind across monitors when Rift's command
# context desyncs from the user's real focus, so resolve globally.)
# Exits non-zero when nothing is focused.

for uuid in $(rift-cli query displays | jq -r '.[].uuid'); do
    ROW=$(rift-cli query workspaces --display "$uuid" 2>/dev/null | jq -r --arg uuid "$uuid" '[.[] | .windows[] | select(.is_focused == true)][0] | "\($uuid)|\(.id.idx)|\(.bundle_id // empty)|\(.app_name // empty)" // empty')
    if [ -n "$ROW" ]; then
        echo "$ROW"
        exit 0
    fi
done
exit 1
