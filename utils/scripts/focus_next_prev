#!/bin/zsh

# Switch to the next/previous non-empty workspace, wrapping around.
# (Rift's native next/prev cannot skip empties, so this steps manually.)
# Usage: focus_next_prev next|prev

DIRECTION=${1:-next}

WORKSPACES_JSON=$(rift-cli query workspaces)
CURRENT=$(echo "$WORKSPACES_JSON" | jq -r '.[] | select(.is_active == true) | .index')
INDEXES=("${(@f)$(echo "$WORKSPACES_JSON" | jq -r 'sort_by(.index) | .[].index')}")
N=${#INDEXES[@]}
[ "$N" -eq 0 ] && exit 0

POS=0
for i in {1..$N}; do
    if [ "${INDEXES[$i]}" = "$CURRENT" ]; then
        POS=$i
        break
    fi
done
[ "$POS" -eq 0 ] && exit 0

TARGET=""
STEP=$POS
for ((k = 0; k < N; k++)); do
    if [ "$DIRECTION" = "next" ]; then
        STEP=$((STEP % N + 1))
    else
        STEP=$(((STEP - 2 + N) % N + 1))
    fi
    CAND=${INDEXES[$STEP]}
    COUNT=$(echo "$WORKSPACES_JSON" | jq -r --argjson idx "$CAND" '.[] | select(.index == $idx) | .window_count // 0')
    if [ "$COUNT" != "0" ]; then
        TARGET=$CAND
        break
    fi
done
[ -z "$TARGET" ] && exit 0

rift-cli execute workspace switch "$TARGET" >/dev/null

sketchybar --trigger rift_workspace_changed
sketchybar --trigger rift_windows_changed
