#!/bin/zsh

# True fullscreen companion: hide the sketchybar on the fullscreen display
# while active (the bar would otherwise overlap the window), restore after.
#
# Two platform facts shape this:
# - Notch displays need no hiding: fullscreen windows never cover the
#   notch/menu strip where the bar sits. Only notch-less displays hide.
# - sketchybar can only toggle the ACTIVE display's bar (`hidden=current`),
#   so track what we hid in a state file instead of blind-toggling.
# (Alt+F stays gap-aware and never hides the bar.)

STATE_FILE=/tmp/rift_fs_hidden_display

# Display (uuid) holding a selected fullscreen window right now, if any.
fullscreen_display() {
    for uuid in $(rift-cli query displays 2>/dev/null | jq -r '.[].uuid'); do
        if rift-cli query layout --display "$uuid" 2>/dev/null | jq -e '[.. | objects | select(.is_selected == true) | select(.is_fullscreen == true)] | length > 0' >/dev/null 2>&1; then
            echo "$uuid"
            return 0
        fi
    done
    return 1
}

# Arrangement ID for a display UUID (empty when unknown).
arr_for() {
    sketchybar --query displays 2>/dev/null | jq -r --arg uuid "$1" '.[] | select(.UUID == $uuid) | ."arrangement-id" // empty'
}

if FULL_UUID=$(fullscreen_display); then
    # Leaving fullscreen: toggle Rift state, restore the bar we hid (if any).
    rift-cli execute window toggle-fullscreen >/dev/null
    if [ -f "$STATE_FILE" ]; then
        sketchybar --bar hidden=current >/dev/null
        rm -f "$STATE_FILE"
    fi
else
    # Entering fullscreen on the active display.
    rift-cli execute window toggle-fullscreen >/dev/null
    IFS=$'\t' read -r ACTIVE_UUID ACTIVE_NAME < <(rift-cli query displays 2>/dev/null | jq -r '.[] | select(.is_active_context == true) | "\(.uuid)\t\(.name)"')
    if [ -n "$ACTIVE_UUID" ] && [ "$ACTIVE_NAME" != "Built-in Retina Display" ]; then
        sketchybar --bar hidden=current >/dev/null
        arr_for "$ACTIVE_UUID" > "$STATE_FILE"
    fi
fi
