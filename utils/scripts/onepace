#!/usr/bin/env zsh
# one_pace — Browse and watch One Pace episodes with fzf + mpv or web server.
#
# Directories in ONE_PACE_DIR use a numbered prefix (e.g. 19_sabaody_archipelago)
# so they sort in canonical One Piece arc order. To add a new arc, create a
# directory like 34_new_arc_name — no script changes needed.

set -euo pipefail

ONE_PACE_DIR="${ONE_PACE_DIR:-$HOME/one_pace}"

# Validate directory exists.
if [[ ! -d "$ONE_PACE_DIR" ]]; then
  echo "Error: One Pace directory not found at $ONE_PACE_DIR" >&2
  exit 1
fi
ONE_PACE_DIR=$(cd "$ONE_PACE_DIR" && pwd)
STATE_FILE="$ONE_PACE_DIR/.one_pace_state.json"

# ── helpers ──────────────────────────────────────────────────────────────────

# Read a key from the JSON state file using Zsh regex pattern matching.
read_state() {
  local key="$1"
  if [[ -f "$STATE_FILE" ]]; then
    local content=$(<"$STATE_FILE")
    if [[ "$content" =~ "\"$key\": *\"?([^\",}]+)\"?" ]]; then
      echo "${match[1]}"
    fi
  fi
}

# Write keys to the state file atomically.
write_state() {
  local arc="$1" episode="$2" timestamp="${3:-0}"
  local ts_clean="${timestamp%%.*}"
  [[ -z "$ts_clean" || ! "$ts_clean" =~ "^[0-9]+$" ]] && ts_clean=0

  cat > "$STATE_FILE" <<EOF
{
  "last_arc": "${arc}",
  "last_episode": "${episode}",
  "timestamp": ${ts_clean}
}
EOF
}

# Format a directory name for display: 19_sabaody_archipelago → 19. Sabaody Archipelago
format_arc() {
  local dir="$1"
  local num="${dir%%_*}"                       # 19
  local name="${dir#*_}"                       # sabaody_archipelago
  local title="${(C)name//_/ }"
  echo "${num}. ${title}"
}

# Repeat an fzf action N times: repeat_action down 3 → "down+down+down"
repeat_action() {
  local action="$1" n="$2" result=""
  local i
  for (( i=0; i<n; i++ )); do
    [[ -n "$result" ]] && result+="+"
    result+="$action"
  done
  echo "$result"
}

# Format episode filename for display: ep01.mp4 → Episode 01
format_episode() {
  local fname="$1"
  local base="${fname:r}"         # ep01
  local num="${base#ep}"          # 01
  if [[ "$num" =~ "^[0-9]+$" ]]; then
    printf "Episode %02d" "$(( 10#$num ))"
  else
    echo "$fname"
  fi
}

# Format timestamp seconds to mm:ss or hh:mm:ss
format_time() {
  local seconds="${1:-0}"
  local sec="${seconds%%.*}"
  [[ -z "$sec" || ! "$sec" =~ "^[0-9]+$" ]] && sec=0
  local h=$(( sec / 3600 ))
  local m=$(( (sec % 3600) / 60 ))
  local s=$(( sec % 60 ))
  if (( h > 0 )); then
    printf "%d:%02d:%02d" "$h" "$m" "$s"
  else
    printf "%02d:%02d" "$m" "$s"
  fi
}

# Show help message
show_help() {
  cat <<'EOF'
onepace — Browse and watch One Pace episodes with fzf + mpv.

USAGE:
  onepace                 Open interactive arc & episode selector (fzf)
  onepace --recent        Replay the last watched episode immediately
  onepace --web [port]    Start local web streaming server & ngrok tunnel
  onepace --status, -s    Display current watch progress summary
  onepace --import <src>  Import a .zip archive or folder of episodes
  onepace --help, -h      Show this help message

KEYBINDINGS IN FZF:
  Enter                   Select arc or episode
  Esc / Ctrl-C            Exit selector

CONFIG:
  ONE_PACE_DIR            Directory containing arc folders (default: ~/one_pace)
EOF
}

# Display watch progress summary
show_status() {
  local last_arc="$(read_state last_arc)"
  local last_ep="$(read_state last_episode)"
  local last_ts="$(read_state timestamp)"

  echo "========================================"
  echo "         One Pace Watch Status          "
  echo "========================================"

  if [[ -n "$last_arc" && -n "$last_ep" ]]; then
    local ts_str=""
    if [[ -n "$last_ts" && "$last_ts" != "0" ]]; then
      ts_str=" (at $(format_time "$last_ts"))"
    fi
    echo "▶ Last Watched : $(format_arc "$last_arc") / $(format_episode "$last_ep")${ts_str}"
  else
    echo "▶ Last Watched : None"
  fi

  local total_arcs=0 total_eps=0 d eps
  for d in "$ONE_PACE_DIR"/*/(N); do
    eps=("$d"/ep*.mp4(Nn))
    if (( ${#eps[@]} > 0 )); then
      total_arcs=$(( total_arcs + 1 ))
      total_eps=$(( total_eps + ${#eps[@]} ))
    fi
  done

  echo "📁 Available Arcs: $total_arcs"
  echo "🎬 Total Episodes: $total_eps"
  echo "========================================"
}

# Canonical arc order — add new arcs at the end.
ARC_ORDER=(
  romance_dawn
  orange_town
  syrup_village
  baratie
  arlong_park
  loguetown
  reverse_mountain
  whisky_peak
  little_garden
  drum_island
  arabasta
  jaya
  skypiea
  long_ring_long_land
  water_7
  enies_lobby
  post_enies_lobby
  thriller_bark
  sabaody_archipelago
  amazon_lily
  impel_down
  marineford
  post_war
  return_to_sabaody
  fishman_island
  punk_hazard
  dressrosa
  zou
  whole_cake_island
  levely
  wano_country
  egghead
  elbaph
)

# Look up the numbered prefix for an arc slug: arc_number sabaody_archipelago → 19
arc_number() {
  local slug="$1"
  case "$slug" in
    reverie) slug="levely" ;;
    sabaody) slug="sabaody_archipelago" ;;
    fishman|fish_man|fishman_island_arc) slug="fishman_island" ;;
    wano) slug="wano_country" ;;
    whole_cake) slug="whole_cake_island" ;;
    post_enies) slug="post_enies_lobby" ;;
    long_ring) slug="long_ring_long_land" ;;
    return_to_sabaody|post_timeskip_sabaody) slug="return_to_sabaody" ;;
  esac

  local i
  for (( i=1; i<=${#ARC_ORDER[@]}; i++ )); do
    if [[ "${ARC_ORDER[$i]}" == "$slug" ]]; then
      printf "%02d" "$i"
      return 0
    fi
  done
  return 1
}

# ── main ─────────────────────────────────────────────────────────────────────

# Handle CLI flags
case "${1:-}" in
  --help|-h)
    show_help
    exit 0
    ;;
  --status|-s)
    show_status
    exit 0
    ;;
  --web)
    port="${2:-3000}"
    web_dir="$(dirname "$0")/onepace_web"

    if [[ ! -d "$web_dir" ]]; then
      echo "Error: Web server directory not found at $web_dir" >&2
      exit 1
    fi

    echo "================================================="
    echo "🏴‍☠️ Starting One Pace Web Server & Tunnel..."
    echo "================================================="

    lan_ip=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo "localhost")

    export PORT="$port"
    export ONE_PACE_DIR="$ONE_PACE_DIR"
    node "$web_dir/server.js" &
    server_pid=$!

    ngrok_log=$(mktemp "$ONE_PACE_DIR/.ngrok_log_XXXXXX")
    trap 'kill $server_pid 2>/dev/null || true; kill ${ngrok_pid:-} 2>/dev/null || true; rm -f "$ngrok_log" 2>/dev/null || true' EXIT

    sleep 1

    echo ""
    echo "🌐 Local Access:   http://localhost:${port}"
    echo "📱 LAN Access:     http://${lan_ip}:${port}"

    ngrok_pid=""
    if command -v ngrok &>/dev/null; then
      ngrok http --url easy-artistic-mullet.ngrok-free.app  "$port" >"$ngrok_log" 2>&1 &
      ngrok_pid=$!

      ngrok_url=""
      attempt=0
      while (( attempt < 10 )); do
        sleep 1
        ngrok_url=$(curl -s http://127.0.0.1:4040/api/tunnels 2>/dev/null | grep -o '"public_url":"[^"]*' | head -1 | cut -d'"' -f4 || true)
        if [[ -n "$ngrok_url" ]]; then
          break
        fi
        attempt=$(( attempt + 1 ))
      done

      if [[ -n "$ngrok_url" ]]; then
        echo "🌍 Public Tunnel:  ${ngrok_url}"
      else
        err_msg=$(grep -i -E "err|error" "$ngrok_log" | head -1 || true)
        if [[ -n "$err_msg" ]]; then
          echo "⚠️ ngrok Notice:   ${err_msg}"
          echo "   (Make sure to run 'ngrok config add-authtoken <your-token>' if missing)"
        else
          echo "🌍 Public Tunnel:  http://127.0.0.1:4040 (check ngrok dashboard)"
        fi
      fi
    else
      echo "ℹ ngrok not found. To access over internet, run: ngrok http $port"
    fi

    echo "================================================="
    echo "Press Ctrl+C to stop web server"
    wait $server_pid
    exit 0
    ;;
esac

# --import <zip|folder>: extract/copy One Pace episodes into correct arc directory.
if [[ "${1:-}" == "--import" ]]; then
  import_src="${2:-}"
  if [[ -z "$import_src" || ! -e "$import_src" ]]; then
    echo "Usage: onepace --import <path-to-zip-or-folder>" >&2
    exit 1
  fi

  src_basename="$(basename "$import_src")"
  src_name="${src_basename%.zip}"

  # Parse arc name from filename/foldername: "[490-513] Sabaody Archipelago [En Sub][720p]"
  arc_display=$(echo "$src_name" | sed 's/^\[[^]]*\] *//; s/ *\[.*$//')

  if [[ -z "$arc_display" ]]; then
    echo "Could not parse arc name from: $src_name" >&2
    exit 1
  fi

  # Convert display name to slug: "Sabaody Archipelago" → "sabaody_archipelago"
  arc_slug=$(echo "$arc_display" | tr '[:upper:]' '[:lower:]' | tr ' ' '_' | tr '-' '_' | tr -cd 'a-z0-9_')

  # Look up the arc number
  arc_num=$(arc_number "$arc_slug") || {
    echo "Unknown arc: '$arc_display' (slug: $arc_slug)" >&2
    echo "" >&2
    echo "Known arcs:" >&2
    local i
    for (( i=1; i<=${#ARC_ORDER[@]}; i++ )); do
      printf "  %02d  %s\n" "$i" "${ARC_ORDER[$i]}" >&2
    done
    exit 1
  }

  target_dir="$ONE_PACE_DIR/${arc_num}_${arc_slug}"
  existing_eps=("$target_dir"/ep*.mp4(N))

  if [[ -d "$target_dir" ]] && (( ${#existing_eps[@]} > 0 )); then
    echo "⚠ Directory already has episodes: $target_dir" >&2
    echo "  Delete it first if you want to re-import." >&2
    exit 1
  fi

  echo "📦 Importing: $arc_display → $target_dir"
  mkdir -p "$target_dir"

  tmp_dir=$(mktemp -d "$ONE_PACE_DIR/.import_XXXXXX")
  trap 'rm -rf "$tmp_dir"' EXIT

  if [[ -f "$import_src" && "$import_src" == *.zip ]]; then
    unzip -q "$import_src" -d "$tmp_dir"
  else
    cp -r "$import_src"/* "$tmp_dir/"
  fi

  count=0
  local mp4_files=("$tmp_dir"/**/*.mp4(Nn))
  local seq_num=1
  for f in "${mp4_files[@]}"; do
    [[ -f "$f" ]] || continue
    fname="$(basename "$f")"
    base="${fname:r}"
    clean=$(echo "$base" | sed -E 's/\[[^]]*\]//g; s/\([^)]*\)//g')
    ep_digit=$(echo "$clean" | grep -oE '[0-9]+' | tail -1 || true)

    if [[ -n "$ep_digit" ]]; then
      ep_num=$(( 10#$ep_digit ))
    else
      ep_num=$seq_num
    fi

    ep_name=$(printf "ep%02d.mp4" "$ep_num")
    mv "$f" "$target_dir/$ep_name"
    count=$(( count + 1 ))
    seq_num=$(( seq_num + 1 ))
  done

  echo "✓ Imported $count episodes into $target_dir"
  ls "$target_dir"
  exit 0
fi

# Collect non-empty arc directories (sorted numerically by prefix).
arcs=()
arc_ep_counts=()
for d in "$ONE_PACE_DIR"/*/(Nn); do
  [[ -d "$d" ]] || continue
  bname="$(basename "$d")"
  ep_files=("$d"/ep*.mp4(Nn))
  if (( ${#ep_files[@]} > 0 )); then
    arcs+=("$bname")
    arc_ep_counts+=("${#ep_files[@]}")
  fi
done

if (( ${#arcs[@]} == 0 )); then
  echo "No arc directories with episode files found in $ONE_PACE_DIR" >&2
  exit 1
fi

# --recent: replay the last-watched episode immediately.
selected_arc=""
selected_episode=""

if [[ "${1:-}" == "--recent" ]]; then
  selected_arc="$(read_state last_arc)"
  selected_episode="$(read_state last_episode)"
  if [[ -z "$selected_arc" || -z "$selected_episode" ]]; then
    echo "No recent episode found. Run onepace first to pick one." >&2
    exit 1
  fi
  episode_path="$ONE_PACE_DIR/$selected_arc/$selected_episode"
  if [[ ! -f "$episode_path" ]]; then
    echo "File not found: $episode_path" >&2
    exit 1
  fi
  echo "▶ Resuming: $(format_arc "$selected_arc") / $(format_episode "$selected_episode")"
fi

if [[ -z "$selected_arc" ]]; then
  fzf_arc_input=""
  arc_pos=0
  last_arc_offset=0
  last_arc="$(read_state last_arc)"
  idx=1
  for arc in "${arcs[@]}"; do
    ep_cnt="${arc_ep_counts[$idx]}"
    disp="$(format_arc "$arc") [${ep_cnt} ep]"
    if [[ "$arc" == "$last_arc" ]]; then
      disp+=" (last watched)"
      last_arc_offset=$arc_pos
    fi
    fzf_arc_input+="${arc} | ${disp}"$'\n'
    arc_pos=$(( arc_pos + 1 ))
    idx=$(( idx + 1 ))
  done

  fzf_arc_opts=(
    --height=100%
    --reverse
    --no-multi
    --no-sort
    --tiebreak=index
    --delimiter=' \| '
    --with-nth=2
    --prompt='Arc ❯ '
    --header='Select an arc to watch'
  )
  if (( last_arc_offset > 0 )); then
    fzf_arc_opts+=(--bind="load:$(repeat_action down $last_arc_offset)")
  fi

  selected_arc_line=$(echo -n "$fzf_arc_input" | fzf "${fzf_arc_opts[@]}" || true)

  if [[ -z "$selected_arc_line" ]]; then
    exit 0
  fi

  selected_arc="${selected_arc_line%% |*}"
fi

# ── episode selection ────────────────────────────────────────────────────────

arc_dir="$ONE_PACE_DIR/$selected_arc"
episodes=("$arc_dir"/ep*.mp4(Nn))

if (( ${#episodes[@]} == 0 )); then
  echo "No ep*.mp4 files found in $arc_dir" >&2
  exit 1
fi

if [[ -z "$selected_episode" ]]; then
  episode_input=""
  ep_pos=0
  last_ep_offset=0
  last_episode="$(read_state last_episode)"
  for ep_path in "${episodes[@]}"; do
    ep="$(basename "$ep_path")"
    ep_disp="$(format_episode "$ep")"
    if [[ "$selected_arc" == "$last_arc" && "$ep" == "$last_episode" ]]; then
      ep_disp+=" (last watched)"
      last_ep_offset=$ep_pos
    fi
    episode_input+="${ep} | ${ep_disp}"$'\n'
    ep_pos=$(( ep_pos + 1 ))
  done

  fzf_ep_opts=(
    --height=100%
    --reverse
    --no-multi
    --no-sort
    --tiebreak=index
    --delimiter=' \| '
    --with-nth=2
    --prompt='Episode ❯ '
    --header="$(format_arc "$selected_arc") — Select an episode"
  )
  if (( last_ep_offset > 0 )); then
    fzf_ep_opts+=(--bind="load:$(repeat_action down $last_ep_offset)")
  fi

  selected_ep_line=$(echo -n "$episode_input" | fzf "${fzf_ep_opts[@]}" || true)

  if [[ -z "$selected_ep_line" ]]; then
    exit 0
  fi

  selected_episode="${selected_ep_line%% |*}"
fi

# ── play & persist ───────────────────────────────────────────────────────────

start_idx=1
for (( i=1; i<=${#episodes[@]}; i++ )); do
  if [[ "$(basename "${episodes[$i]}")" == "$selected_episode" ]]; then
    start_idx=$i
    break
  fi
done

selected_arc_idx=-1
for (( i=1; i<=${#arcs[@]}; i++ )); do
  if [[ "${arcs[$i]}" == "$selected_arc" ]]; then
    selected_arc_idx=$i
    break
  fi
done

playlist=()
for (( idx=start_idx; idx<=${#episodes[@]}; idx++ )); do
  playlist+=("${episodes[$idx]}")
done

if (( selected_arc_idx != -1 )); then
  for (( a_idx=selected_arc_idx+1; a_idx<=${#arcs[@]}; a_idx++ )); do
    next_arc="${arcs[$a_idx]}"
    next_arc_dir="$ONE_PACE_DIR/$next_arc"
    next_episodes=("$next_arc_dir"/ep*.mp4(Nn))
    for ep_path in "${next_episodes[@]}"; do
      playlist+=("$ep_path")
    done
  done
fi

echo "▶ Playing from: $(format_arc "$selected_arc") / $(format_episode "$selected_episode")"

mpv_log=$(mktemp "$ONE_PACE_DIR/.mpv_log_XXXXXX")
trap 'rm -f "$mpv_log"' EXIT

# Build MPV options disabling watch_later playlist redirects so selected_episode ALWAYS plays
mpv_opts=(--no-resume-playback --save-position-on-quit --term-playing-msg='ONE_PACE_PLAYING:${path}' --title="One Pace")

start_ts="$(read_state timestamp)"
if [[ -n "$start_ts" && "$start_ts" != "0" && "$selected_arc" == "$(read_state last_arc)" && "$selected_episode" == "$(read_state last_episode)" ]]; then
  echo "⏱ Resuming at timestamp: $(format_time "$start_ts") (${start_ts}s)"
  mpv_opts+=(--start="$start_ts")
fi

mpv "${mpv_opts[@]}" "${playlist[@]}" 2>&1 | tee "$mpv_log"

# Parse last played episode from MPV terminal output log
last_played_line=$(grep "ONE_PACE_PLAYING:" "$mpv_log" | tail -1 || true)
if [[ -n "$last_played_line" ]]; then
  last_path="${last_played_line#ONE_PACE_PLAYING:}"
  saved_arc="$(basename "$(dirname "$last_path")")"
  saved_ep="$(basename "$last_path")"
  saved_ts=0

  # Read saved timestamp from MPV watch_later file
  if command -v md5 &>/dev/null; then
    hash=$(echo -n "$last_path" | md5 | tr '[:lower:]' '[:upper:]')
    wl_file="$HOME/.config/mpv/watch_later/$hash"
    if [[ -f "$wl_file" ]]; then
      ts_line=$(grep "^start=" "$wl_file" | head -1 || true)
      if [[ -n "$ts_line" ]]; then
        raw_ts="${ts_line#start=}"
        saved_ts="${raw_ts%%.*}"
      fi
    fi
  fi

  if [[ -n "$saved_arc" && -n "$saved_ep" ]]; then
    write_state "$saved_arc" "$saved_ep" "$saved_ts"
    echo "✓ State saved: $(format_arc "$saved_arc") / $(format_episode "$saved_ep") (at $(format_time "$saved_ts"))"
  fi
fi
