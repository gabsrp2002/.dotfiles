#!/bin/zsh

# Mirror Aerospace's `move-node-to-monitor --focus-follows-window`: move the
# focused window to the adjacent display and pull focus after it.
# (Rift updates its internal focus on move, but macOS key focus stays behind,
# so activate the app to bring key focus to the moved window.)
# The target is resolved globally (see focused_window_info) and passed
# explicitly: implicit "focused window" resolution desyncs across displays.
#
# Scrolling layout: `display move-window` does not transfer windows between
# scrolling displays, so an explicit transfer walks the window to the strip
# edge with move_column_or_cross (reorder/expel steps) and lets the final step
# cross via native `move-node`. The window is tracked by id across displays,
# never by focus. Non-scrolling layouts use `display move-window` directly.
# Usage: move_window_to_display left|right|up|down

DIRECTION=$1

INFO=$(~/scripts/focused_window_info) || exit 0
UUID=${INFO%%|*}
REST=${INFO#*|}
IDX=${REST%%|*}
REST=${REST#*|}
BUNDLE=${REST%%|*}
APP=${REST#*|}

activate() {
    if [ -n "$BUNDLE" ]; then
        open -b "$BUNDLE" 2>/dev/null || open -a "$APP" 2>/dev/null
    elif [ -n "$APP" ]; then
        open -a "$APP" 2>/dev/null
    fi
}

MODE=$(rift-cli query layout --display "$UUID" 2>/dev/null | jq -r '.mode // empty')
if [ -z "$MODE" ]; then
    MODE=$(rift-cli query workspace-layout --display "$UUID" 2>/dev/null | jq -r '.[] | select(.is_active == true) | .layout_mode // empty')
fi

if [ "$MODE" != "scrolling" ]; then
    rift-cli execute display move-window --direction "$DIRECTION" --window-id "$IDX" >/dev/null
    # Wait for the move to settle before activating: an activation delivered
    # while the window is still transitioning has its focus event ignored as
    # "not in active layout" (stale focus wins). Poll the globally focused
    # window instead of a fixed sleep; require it stable across two
    # consecutive polls, capped at the old 0.5s budget.
    POLLS=0
    STABLE=0
    while [ "$POLLS" -lt 6 ]; do
        FOCUS_IDX=$(~/scripts/focused_window_info 2>/dev/null | cut -d'|' -f2)
        if [ -n "$FOCUS_IDX" ] && [ "$FOCUS_IDX" = "$IDX" ]; then
            STABLE=$((STABLE + 1))
            [ "$STABLE" -ge 2 ] && break
        else
            STABLE=0
        fi
        sleep 0.05
        POLLS=$((POLLS + 1))
    done
    activate
    sketchybar --trigger rift_workspace_changed
    sketchybar --trigger rift_windows_changed
    exit 0
fi

# Scrolling: up/down have no column beyond (reorder only) — delegate.
case "$DIRECTION" in
    up|down) exec ~/scripts/move_column_or_cross "$DIRECTION" ;;
esac

# Display currently holding window $IDX (membership, not focus).
window_display() {
    local uuid found
    for uuid in $(rift-cli query displays | jq -r '.[].uuid'); do
        found=$(rift-cli query workspaces --display "$uuid" 2>/dev/null | jq -r --argjson idx "$IDX" '[.[] | .windows[] | select(.id.idx == $idx)][0] | .id.idx // empty')
        if [ -n "$found" ]; then
            echo "$uuid"
            return 0
        fi
    done
    return 1
}

# Walk left/right to the strip edge, then cross. Cap the walk at the column
# count + 2 so a stuck step cannot loop forever.
COLS=$(rift-cli query workspaces --display "$UUID" 2>/dev/null | jq -r '[.[] | select(.is_active == true) | .windows[] | .layout_position.column] | map(select(. != null)) | (max // 0) + 3')
case "$COLS" in
    ''|*[!0-9]*) CAP=10 ;;
    *) CAP=$COLS ;;
esac
[ "$CAP" -lt 3 ] && CAP=3

i=0
while [ "$i" -lt "$CAP" ]; do
    CUR=$(window_display) || break
    [ "$CUR" != "$UUID" ] && break
    ~/scripts/move_column_or_cross "$DIRECTION"
    # Settle: poll until the window leaves this display, bounded (~0.3s).
    for _ in 1 2 3 4 5 6; do
        CUR=$(window_display) || break
        [ "$CUR" != "$UUID" ] && break
        sleep 0.05
    done
    [ "$CUR" != "$UUID" ] && break
    i=$((i + 1))
done

# Let the final cross settle before activating (a stale focus event would win
# otherwise); bounded poll for the moved window to take focus.
for _ in 1 2 3 4 5; do
    FOCUS_IDX=$(~/scripts/focused_window_info 2>/dev/null | cut -d'|' -f2)
    [ -n "$FOCUS_IDX" ] && [ "$FOCUS_IDX" = "$IDX" ] && break
    sleep 0.05
done
activate
sketchybar --trigger rift_workspace_changed
sketchybar --trigger rift_windows_changed
