#!/bin/zsh

# Mirror Aerospace's `move-node-to-monitor --focus-follows-window`: move the
# focused window to the adjacent display and pull focus after it.
# (Rift updates its internal focus on move, but macOS key focus stays behind,
# so activate the app to bring key focus to the moved window.)
# The target is resolved globally (see focused_window_info) and passed
# explicitly: implicit "focused window" resolution desyncs across displays.
# Usage: move_window_to_display left|right|up|down

DIRECTION=$1

INFO=$(~/scripts/focused_window_info) || exit 0
UUID=${INFO%%|*}
REST=${INFO#*|}
IDX=${REST%%|*}
REST=${REST#*|}
BUNDLE=${REST%%|*}
APP=${REST#*|}

rift-cli execute display move-window --direction "$DIRECTION" --window-id "$IDX" >/dev/null

# Let the move settle before activating: an immediate activation resolves
# while the window is still transitioning, and its focus event is then
# ignored as "not in active layout" (stale focus wins).
sleep 0.5

if [ -n "$BUNDLE" ]; then
    open -b "$BUNDLE" 2>/dev/null || open -a "$APP" 2>/dev/null
elif [ -n "$APP" ]; then
    open -a "$APP" 2>/dev/null
fi

sketchybar --trigger rift_workspace_changed
sketchybar --trigger rift_windows_changed
